{
  "name": "robotistan-supply-assistant",
  "version": "1.1.3",
  "description": "Zen Browser / Firefox WebExtension for Robotistan Pro & LCSC: Live LCSC stock badges, 1-click cart addition, KiCad BOM to Cart automation, MOQ scaling, and proforma pre-order handling",
  "main": "background.js",
  "scripts": {
    "test:parse": "node test-parser.js",
    "test:api": "node test-robotistan-api.js",
    "lint": "web-ext lint --self-hosted",
    "package": "web-ext build --overwrite-dest",
    "build:xpi": "web-ext build --overwrite-dest --filename robotistan-supply-assistant.xpi --artifacts-dir ./dist",
    "install:zen": "node scripts/install-zen.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omrfrkmll/robotistan-supply-assistant.git"
  },
  "keywords": [
    "kicad",
    "bom",
    "robotistan",
    "robotistanpro",
    "lcsc",
    "zen-browser",
    "firefox-extension",
    "webextension",
    "electronics"
  ],
  "author": "ilteray",
  "license": "MIT",
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
