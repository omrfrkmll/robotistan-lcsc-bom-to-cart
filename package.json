{
  "name": "robotistan-lcsc-bom-to-cart",
  "version": "1.0.0",
  "description": "Zen Browser / Firefox WebExtension to import KiCad BOM (ibom.html or CSV) and automatically add components to Robotistan Pro cart with MOQ, packaging steps, batch scaling, and pre-order handling",
  "main": "background.js",
  "scripts": {
    "test:parse": "node test-parser.js",
    "test:api": "node test-robotistan-api.js",
    "lint": "web-ext lint --self-hosted",
    "package": "web-ext build --overwrite-dest",
    "build:xpi": "web-ext build --overwrite-dest --filename robotistan-bom-to-cart_ilteray.xpi --artifacts-dir ./dist",
    "install:zen": "node scripts/install-zen.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omrfrkmll/robotistan-lcsc-bom-to-cart.git"
  },
  "keywords": [
    "kicad",
    "bom",
    "robotistan",
    "robotistanpro",
    "lcsc",
    "zen-browser",
    "firefox-extension",
    "webextension"
  ],
  "author": "ilteray",
  "license": "MIT",
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
