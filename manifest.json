{
  "manifest_version": 3,
  "name": "Robotistan Pro - Tedarik Asistanı",
  "version": "1.1.1",
  "description": "LCSC üzerinde gezinirken Robotistan Pro canlı stok ve fiyat rozetleri gösterir; KiCad BOM listelerini (ibom.html veya CSV) Robotistan Pro sepetine MOQ katlarıyla aktarır.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.lcsc.com/*",
    "*://lcsc.com/*",
    "*://*.robotistanpro.com/*",
    "*://robotistanpro.com/*"
  ],
  "background": {
    "scripts": [
      "lib/robotistan-api.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.lcsc.com/*",
        "*://lcsc.com/*"
      ],
      "js": [
        "content/lcsc/content.js"
      ],
      "css": [
        "content/lcsc/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.robotistanpro.com/*",
        "*://robotistanpro.com/*"
      ],
      "js": [
        "lib/lz-string.js",
        "lib/bom-parser.js",
        "lib/robotistan-api.js",
        "content/robotistan/content.js"
      ],
      "css": [
        "content/robotistan/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Robotistan Pro Tedarik Asistanı",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "robotistan-supply-assistant@ilteray",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/omrfrkmll/robotistan-supply-assistant/master/updates.json"
    }
  }
}
